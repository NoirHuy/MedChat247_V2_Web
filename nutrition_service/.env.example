# ==============================================================================
# 🥗 Nutrition Service (Python Flask) — environment template
# ==============================================================================
# Trong docker-compose.yml các biến này được map tự động từ file .env gốc
# của medchat_web (xem phần NUTRITION_* trong medchat_web/.env.example).
# File này chỉ dùng khi chạy service standalone:  python app.py
# ==============================================================================

# Flask listen port
NUTRITION_PORT=5000

# LLM OpenAI-compatible dùng cho nhận xét lâm sàng (graceful fallback nếu thiếu)
LLM_BASE_URL=http://YOUR_LLM_HOST/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=your-model-name
LLM_TIMEOUT=15
LLM_TEMPERATURE=0.7

# Neo4j Knowledge Graph — database cách ly riêng cho dữ liệu dinh dưỡng
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=nutrition

# CORS (khi frontend gọi thẳng — trong mô hình Gateway thì Node là client duy nhất)
CORS_ORIGINS=
CLIENT_ORIGIN=
