# =============================================================================
# MedChat Root — Environment Variables (Frontend + Docker Compose)
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to Git — it is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 🌐 VITE FRONTEND
# -----------------------------------------------------------------------------
# Base URL for API calls from the browser.
# Dev:  leave empty (Vite proxies /api/* to localhost:4000)
# Prod: leave empty (Caddy proxies /api/* to backend container)
VITE_API_URL=

# Google OAuth 2.0 Client ID — must match GOOGLE_CLIENT_ID in back_end/.env
# Get one at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 🔐 CONTAINER SECRETS (required by docker-compose.yml — compose refuses to
# start without them)
# -----------------------------------------------------------------------------
# MongoDB root credentials. Use ALPHANUMERIC values only (no special URI chars).
MONGO_ROOT_USER=medchat
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MONGO_ROOT_PASS=change-me-strong-password

# Redis password (requirepass). Same generator as above.
REDIS_PASSWORD=change-me-strong-password

# -----------------------------------------------------------------------------
# 🥗 NUTRITION SERVICE (Python Flask — specialty 'nutrition_consultation')
# -----------------------------------------------------------------------------
# Nếu để trống, nutrition service tự dùng NINEROUTER_URL / NINEROUTER_API /
# OPENROUTER_MODEL_CHAT từ back_end/.env (xem nutrition_service/src/core/settings.py).
NUTRITION_LLM_BASE_URL=
NUTRITION_LLM_API_KEY=
NUTRITION_LLM_MODEL=

# Neo4j database cách ly cho dữ liệu dinh dưỡng (đã set trong docker-compose.yml).
# Neo4j Community chỉ hỗ trợ 1 database — service sẽ tự fallback về `neo4j`.
NUTRITION_NEO4J_DATABASE=nutrition

# -----------------------------------------------------------------------------
# 🐳 DOCKER / CADDY (used by docker-compose.prod.yml)
# -----------------------------------------------------------------------------
# Your production domain — used by Caddy for automatic HTTPS (Let's Encrypt)
# Leave as-is for local testing with: DOMAIN=localhost
DOMAIN=your-domain.example.com
