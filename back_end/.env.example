# =============================================================================
# MedChat Backend — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to Git — it is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 🌐 SERVER
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# Frontend origin allowed to call this API with credentials
# Dev:  http://localhost:5173
# Prod: https://your-domain.example.com
CLIENT_ORIGIN=http://localhost:5173

# Whether to set the Secure flag on session cookies (must be true on HTTPS)
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# ✉️ SMTP EMAIL — Verification codes and password resets
# -----------------------------------------------------------------------------
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# Use an App Password for Gmail, never your primary account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="MedChat247 <no-reply@your-domain.example.com>"

# -----------------------------------------------------------------------------
# 🔐 SECURITY
# -----------------------------------------------------------------------------
# Long random string used to sign JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-long-random-jwt-secret-here

# AES-256 encryption key for personal memory data — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMORY_ENCRYPTION_KEY=your-32-byte-hex-memory-encryption-key-here

# -----------------------------------------------------------------------------
# 🤖 AI — 9Router (LLM Gateway)
# -----------------------------------------------------------------------------
NINEROUTER_API=your-9router-api-key-here
# Docker internal: http://ninerouter:20128/v1
# Local (outside Docker): http://127.0.0.1:20128/v1
NINEROUTER_URL=http://ninerouter:20128/v1

# Model used for main chat replies
OPENROUTER_MODEL_CHAT=gemini/gemini-3.1-flash-lite-preview
# Model used for NER / memory extraction (background, can be slower)
OPENROUTER_MODEL_NER=gemini/gemini-3.1-flash-lite-preview
# Legacy fallback model alias
OPENROUTER_MODEL=gemini/gemini-3.1-flash-lite-preview

# -----------------------------------------------------------------------------
# 🔮 OPENROUTER DIRECT — Embedding API (separate from 9Router proxy)
# -----------------------------------------------------------------------------
# Your personal OpenRouter API key — get one at: https://openrouter.ai/keys
# Used exclusively for vector embedding calls (NOT for chat completions)
OPENROUTER_API=sk-or-v1-your-openrouter-api-key-here

# Embedding model to use for symptom vector search
# Recommended: perplexity/pplx-embed-v1-4b ($0.03/1M tokens)
OPENROUTER_EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b

# Cosine similarity threshold [0.0 – 1.0] for symptom vector matching
# Higher = stricter matching; lower = more lenient (0.35 recommended for perplexity/pplx-embed-v1-4b)
EMBEDDING_SIMILARITY_THRESHOLD=0.35


# -----------------------------------------------------------------------------
# 🔑 THIRD-PARTY SERVICES
# -----------------------------------------------------------------------------
# UMLS Metathesaurus API — https://uts.nlm.nih.gov/uts/signup-login
UMLS_API_KEY=your-umls-api-key-here

# Google OAuth 2.0 Client ID — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 🗄️ MONGODB
# -----------------------------------------------------------------------------
# Docker internal (credentials come from MONGO_ROOT_* in the ROOT .env —
# docker-compose.yml builds this URI automatically, no need to edit here):
#   mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASS>@mongodb:27017/medchat?authSource=admin
# Local (outside Docker), same credentials as root .env:
#   mongodb://medchat:<MONGO_ROOT_PASS>@127.0.0.1:27018/medchat?authSource=admin
MONGODB_URI=mongodb://mongodb:27017/medchat?authSource=admin

# -----------------------------------------------------------------------------
# 🕸️ NEO4J GRAPH DATABASE
# -----------------------------------------------------------------------------
# Docker internal: bolt://neo4j:7687
# Local (outside Docker): bolt://127.0.0.1:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# 🧠 FINE-TUNED MODEL (Modal vLLM - Chuyên khoa: 'general_consultation')
# -----------------------------------------------------------------------------
# Endpoint vLLM của model fine-tune chạy trên Modal.
# Khi người dùng chọn chuyên khoa "Tư vấn tổng quát", backend sẽ gửi trực tiếp
# request đến endpoint này với streaming SSE chuẩn OpenAI.
FINETUNE_LLM_BASE_URL=https://huyphuhunghuyfb--medchat247-backend-serve-vllm.modal.run/v1
FINETUNE_LLM_API_KEY=medchat247-secret-key-2026

# -----------------------------------------------------------------------------
# 🥗 NUTRITION MICROSERVICE (specialty 'nutrition_consultation')
# -----------------------------------------------------------------------------
# Node forwards nutrition chats to this Python Flask service.
# Docker: compose injects http://nutrition:5000 automatically.
# Local dev (run `python app.py` inside nutrition_service/): 127.0.0.1:5000
NUTRITION_SERVICE_URL=http://127.0.0.1:5000
NUTRITION_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# 💳 PAYMENTS — PayPal REST API v2
# -----------------------------------------------------------------------------
# Get credentials at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here
# Mode: 'sandbox' (for testing) or 'live' (for real payments)
PAYPAL_MODE=sandbox

# Webhook ID — lấy từ PayPal Dashboard → App của bạn → Webhooks
# Phải khớp với Webhook ID mà PayPal sinh ra khi bạn register URL webhook.
# Endpoint backend: POST https://<your-domain>/api/payments/paypal/webhook
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id-here

# -----------------------------------------------------------------------------
# 👤 ADMIN
# -----------------------------------------------------------------------------
# Không còn cấp quyền admin theo email (tránh kẻ khác đăng ký trước email đó).
# Nâng quyền admin bằng CLI:
#   node scripts/promote-admin.js admin@your-domain.example.com
# Hạ quyền:
#   node scripts/promote-admin.js --revoke admin@your-domain.example.com

# -----------------------------------------------------------------------------
# ⚙️ GRAPHRAG SCORING WEIGHTS (optional — defaults shown)
# -----------------------------------------------------------------------------
# W_CHIEF_COMPLAINT=1.5
# W_ASSOCIATED=1.0
# PENALTY_MULTIPLIER=0.8
# CONFIDENCE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# 🚀 REDIS — Distributed cache & rate limiting
# -----------------------------------------------------------------------------
# Redis is optional. If REDIS_ENABLED=false or the server is unreachable,
# the system gracefully falls back to in-memory caches. Multi-instance
# deployments REQUIRE Redis to share SCE state, sessions, and rate-limit counters.
# Set REDIS_ENABLED=false to disable Redis entirely.
REDIS_ENABLED=true

# Connection URL — adjust for your environment
# Local (outside Docker): redis://127.0.0.1:6379
# Docker internal: redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# Optional password (leave blank if Redis has no auth)
# REDIS_PASSWORD=your-redis-password

# -----------------------------------------------------------------------------
# 🧠 MEMORY SETTINGS (optional — defaults shown)
# -----------------------------------------------------------------------------
# MEMORY_MAX_PER_USER=500
# MEMORY_MIN_CONFIDENCE=0.70
# MEMORY_TOKEN_BUDGET=500


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="MedChat247 <your-email@gmail.com>"

